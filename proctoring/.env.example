DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_portal
DB_USER=root
DB_PASSWORD=

FLASK_DEBUG=false
PROCTORING_PORT=5001
PROCTORING_API_KEY=change_this_api_key_before_production

# Detection thresholds
FACE_DETECTION_INTERVAL=5
LOOKING_AWAY_THRESHOLD_SECONDS=10
FACE_MISSING_THRESHOLD_SECONDS=15

# Snapshot settings (set to true ONLY after disclosing to students)
SNAPSHOT_ENABLED=false
SNAPSHOT_PATH=snapshots/
RETENTION_DAYS=30
